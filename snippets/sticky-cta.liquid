{% comment %}
  Mobile Sticky Bottom CTA Snippet
{% endcomment %}

<div id="sticky-cta" class="fixed bottom-0 inset-x-0 z-50 p-3 sm:hidden transition-all duration-300 sticky-cta-hidden">
  <div class="bg-white/95 dark:bg-slate-900/95 backdrop-blur-xl rounded-full p-2 pr-6 pl-2 flex items-center justify-between border border-slate-200/80 dark:border-slate-800 shadow-2xl shadow-slate-900/15 max-w-md mx-auto gap-2">
    <div class="flex flex-col justify-center">
      <div class="flex items-baseline gap-1.5">
        <span class="text-2xl font-black tracking-tight text-emerald-600 dark:text-emerald-400">
          189 <span class="text-sm font-extrabold text-slate-700 dark:text-slate-300">ر.س</span>
        </span>
        <span class="text-xs font-semibold text-slate-400 line-through">299</span>
      </div>
      <span class="text-xs font-extrabold text-rose-500 uppercase tracking-wider" style="margin-top:-4px">🔥 خصم 37%-</span>
    </div>
    <button type="button" onclick="scrollToOrder()" class="text-white font-extrabold px-6 py-3 rounded-full text-base shadow-lg cursor-pointer transition-all active:scale-95 flex items-center gap-2 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600">
