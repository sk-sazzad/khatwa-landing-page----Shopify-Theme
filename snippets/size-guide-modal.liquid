{% comment %}
  Size Guide Modal Snippet
{% endcomment %}

<div id="size-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs hidden" onclick="closeSizeGuide()">
  <div class="bg-white dark:bg-slate-800 rounded-3xl p-6 sm:p-8 max-w-md w-full border border-slate-200 dark:border-slate-700 shadow-2xl relative" onclick="event.stopPropagation()">
    <div class="flex items-center justify-between mb-4 border-b border-slate-100 dark:border-slate-700 pb-3">
      <h3 class="text-xl font-extrabold text-slate-900 dark:text-white">دليل المقاسات والقياسات</h3>
      <button type="button" onclick="closeSizeGuide()" class="p-1 rounded-full text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-right text-sm">
        <thead>
          <tr class="border-b border-slate-200 dark:border-slate-700 text-xs font-bold uppercase tracking-wider text-slate-400">
            <th class="py-2.5 px-3">المقاس الأوروبي</th>
            <th class="py-2.5 px-3">طول القدم</th>
            <th class="py-2.5 px-3">المقاس الأمريكي</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-700/60 font-medium text-slate-700 dark:text-slate-200">
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30"><td class="py-2.5 px-3 font-bold">EU 36</td><td class="py-2.5 px-3">23 سم</td><td class="py-2.5 px-3">W5 / M3</td></tr>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30"><td class="py-2.5 px-3 font-bold">EU 37</td><td class="py-2.5 px-3">23.5 سم</td><td class="py-2.5 px-3">W6 / M4</td></tr>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30"><td class="py-2.5 px-3 font-bold">EU 38</td><td class="py-2.5 px-3">24 سم</td><td class="py-2.5 px-3">W7 / M5</td></tr>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30"><td class="py-2.5 px-3 font-bold">EU 39/40</td><td class="py-2.5 px-3">25 سم</td><td class="py-2.5 px-3">W8-9 / M6-7</td></tr>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30"><td class="py-2.5 px-3 font-bold">EU 41</td><td class="py-2.5 px-3">26 سم</td><td class="py-2.5 px-3">W10 / M8</td></tr>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30"><td class="py-2.5 px-3 font-bold">EU 42/43</td><td class="py-2.5 px-3">27 سم</td><td class="py-2.5 px-3">M9-10</td></tr>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30"><td class="py-2.5 px-3 font-bold">EU 44</td><td class="py-2.5 px-3">28 سم</td><td class="py-2.5 px-3">M11</td></tr>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30"><td class="py-2.5 px-3 font-bold">EU 45</td><td class="py-2.5 px-3">29 سم</td><td class="py-2.5 px-3">M12</td></tr>
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-xs text-slate-500 dark:text-slate-400 leading-relaxed bg-slate-50 dark:bg-slate-900/60 p-3 rounded-xl border border-slate-200 dark:border-slate-800">
      <strong>نصيحة:</strong> إذا كنت بين مقاسين أو تفضّل مقاساً أوسع وأريح، ننصحك باختيار مقاس أكبر.
    </p>
  </div>
</div>
