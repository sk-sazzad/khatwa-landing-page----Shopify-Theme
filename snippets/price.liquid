{% comment %}
    Renders product price formatting with discount comparison
{% endcomment %}
{%- liquid
  assign target = product.selected_or_first_available_variant | default: product
  assign compare_at_price = target.compare_at_price
  assign price = target.price | default: 19900
-%}

<div class="price-box">
  <span class="price-current">
    {{ price | money }}
  </span>

  {%- if compare_at_price > price -%}
    <span class="price-compare">
      {{ compare_at_price | money }}
    </span>
    
    {% assign discount_percent = compare_at_price | minus: price | times: 100.0 | divided_by: compare_at_price | round %}
    <span class="badge badge-discount bg-red-500 text-white px-2 py-1 rounded-full text-xs font-bold">
      {{ 'product.discount_off' | t }} {{ discount_percent }}%
    </span>
  {%- endif -%}
</div>
