[
  {
    "name": "theme_info",
    "theme_name": "Khatwa Landing Page",
    "theme_author": "Antigravity AI",
    "theme_version": "1.0.0",
    "theme_documentation_url": "https://shopify.com",
    "theme_support_url": "https://shopify.com"
  },
  {
    "name": "General & Language Settings",
    "settings": [
      {
        "type": "select",
        "id": "default_language",
        "label": "Default Store Language",
        "options": [
          { "value": "ar", "label": "Arabic (العربية - RTL)" },
          { "value": "en", "label": "English (LTR)" }
        ],
        "default": "ar"
      },
      {
        "type": "checkbox",
        "id": "enable_rtl",
        "label": "Enable RTL Layout for Arabic",
        "default": true
      },
      {
        "type": "text",
        "id": "store_brand_name",
        "label": "Brand Name",
        "default": "خطوة | Khatwa"
      }
    ]
  },
  {
    "name": "Colors & Branding",
    "settings": [
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary Accent Color",
        "default": "#2563eb"
      },
      {
        "type": "color",
        "id": "color_primary_hover",
        "label": "Primary Hover Color",
        "default": "#1d4ed8"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "label": "Secondary Accent Color",
        "default": "#10b981"
      },
      {
        "type": "color",
        "id": "color_bg_main",
        "label": "Background Main Color",
        "default": "#0f172a"
      },
      {
        "type": "color",
        "id": "color_bg_card",
        "label": "Card Background Color",
        "default": "#1e293b"
      },
      {
        "type": "color",
        "id": "color_text_main",
        "label": "Text Main Color",
        "default": "#f8fafc"
      },
      {
        "type": "color",
        "id": "color_text_muted",
        "label": "Text Muted Color",
        "default": "#94a3b8"
      },
      {
        "type": "color",
        "id": "color_badge_discount",
        "label": "Discount Badge Color",
        "default": "#ef4444"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading Font",
        "default": "sans-serif"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body Font",
        "default": "sans-serif"
      }
    ]
  },
  {
    "name": "Cart Drawer & Checkout",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_cart_drawer",
        "label": "Enable Slide-out Cart Drawer",
        "default": true
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free Shipping Threshold ($)",
        "default": 100
      }
    ]
  }
]
