{% comment %}
  Announcement Bar Section with rotating slides & Theme Editor customization
{% endcomment %}

<div class="bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 text-white h-10 flex items-center justify-center overflow-hidden relative shadow-sm text-xs sm:text-sm font-semibold tracking-wide">
  {% for block in section.blocks %}
    <div id="ann-{{ forloop.index0 }}" class="ann-item {% if forloop.first %}visible-ann{% else %}hidden-ann{% endif %}" {{ block.shopify_attributes }}>
      {% if block.settings.icon == 'truck' %}
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 17H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v3"/><polygon points="12 12 22 12 22 17 12 17 12 12"/><circle cx="17" cy="21" r="2"/><circle cx="7" cy="21" r="2"/></svg>
      {% elsif block.settings.icon == 'fire' %}
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
      {% else %}
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-yellow-400" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      {% endif %}
      <span>{{ block.settings.text }}</span>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Announcement Text",
          "default": "توصيل سريع في جميع أنحاء المملكة العربية السعودية — شحن سريع"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck / Delivery" },
            { "value": "fire", "label": "Fire / Flame" },
            { "value": "star", "label": "Star / Rating" }
          ],
          "default": "truck"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "توصيل سريع في جميع أنحاء المملكة العربية السعودية — شحن سريع",
            "icon": "truck"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "عرض محدود — وفّر 37% اليوم فقط",
            "icon": "fire"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "راحة EVA الفاخرة · 4,892 تقييم موثّق",
            "icon": "star"
          }
        }
      ]
    }
  ]
}
{% endschema %}
