<section id="order" class="py-16 lg:py-24 bg-slate-100/80 border-t border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-xl mx-auto mb-12">
      <span class="inline-block text-xs font-black uppercase tracking-widest bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 text-white px-4 py-1.5 rounded-full shadow-sm mb-3">
        {{ section.settings.badge | default: 'طلب سريع ومباشر' }}
      </span>
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        {{ section.settings.title | default: 'أكمل طلبك الآن' }}
      </h2>
      <p class="mt-2 text-slate-600 text-sm sm:text-base font-medium">
        {{ section.settings.subtitle | default: 'استلم طلبك خلال 2 إلى 4 أيام عمل — الدفع عند الاستلام' }}
      </p>
    </div>

    <!-- Success Screen (Hidden by default, shown by JS on submission) -->
    <div id="checkout-success-screen" class="hidden max-w-lg mx-auto bg-white rounded-3xl p-8 text-center border border-slate-200 shadow-xl flex-col items-center gap-4 animate-in fade-in zoom-in-95 duration-300">
      <div class="w-16 h-16 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto mb-3">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
      </div>
      <h3 class="text-2xl font-black text-slate-900">
        تم إرسال طلبك بنجاح!
      </h3>
      <p class="text-sm text-slate-600 leading-relaxed" id="checkout-success-message">
        شكراً لك! تم استلام طلبك بنجاح. سيتواصل معك فريق التوصيل قريباً لتأكيد الموعد.
      </p>
      <div class="w-full bg-slate-50 p-4 rounded-2xl text-xs text-right space-y-1 text-slate-600 border border-slate-200 my-2" id="checkout-success-details">
        <!-- Filled dynamically by JS -->
      </div>
      <button
        type="button"
        id="reset-checkout-form"
        class="mt-2 inline-flex items-center gap-2 bg-slate-900 text-white px-6 py-3 rounded-xl font-bold text-sm cursor-pointer hover:opacity-90 transition-opacity"
      >
        <span>إجراء طلب آخر</span>
      </button>
    </div>

    <!-- Checkout Form -->
    <form id="express-checkout-form" action="/cart/add" method="post" enctype="multipart/form-data">
      <input type="hidden" name="id" id="selected-variant-id" value="{{ product.selected_or_first_available_variant.id }}">

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Input Fields Column -->
        <div class="lg:col-span-7 flex flex-col gap-6">
          
          <!-- Shipping info -->
          <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-xs flex flex-col gap-5 text-right">
            <h3 class="text-lg font-extrabold text-slate-900 border-b border-slate-100 pb-3">
              1. معلومات التوصيل
            </h3>

            <div class="flex flex-col gap-1.5">
              <label class="text-xs font-bold uppercase tracking-wider text-slate-700">الاسم الكامل *</label>
              <input
                type="text"
                name="properties[Full Name]"
                id="input-fullname"
                required
                placeholder="مثال: أحمد المنصور"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 text-sm outline-none focus:border-blue-600"
              >
            </div>

            <div class="flex flex-col gap-1.5">
              <label class="text-xs font-bold uppercase tracking-wider text-slate-700">رقم الجوال *</label>
              <input
                type="tel"
                name="properties[Phone]"
                id="input-phone"
                required
                placeholder="مثال: 0501234567"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 text-sm outline-none focus:border-blue-600"
              >
            </div>

            <div class="flex flex-col gap-1.5">
              <label class="text-xs font-bold uppercase tracking-wider text-slate-700">المدينة *</label>
              <select
                name="properties[City]"
                id="input-city"
                required
                class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 text-sm outline-none focus:border-blue-600 cursor-pointer"
              >
                <option value="">اختر مدينتك</option>
                <option value="الرياض">الرياض</option>
                <option value="جدة">جدة</option>
                <option value="مكة المكرمة">مكة المكرمة</option>
                <option value="المدينة المنورة">المدينة المنورة</option>
                <option value="الدمام">الدمام</option>
                <option value="الخبر">الخبر</option>
                <option value="تبوك">تبوك</option>
                <option value="أبها">أبها</option>
                <option value="الطائف">الطائف</option>
                <option value="بريدة">بريدة</option>
                <option value="خميس مشيط">خميس مشيط</option>
                <option value="حائل">حائل</option>
                <option value="نجران">نجران</option>
                <option value="جيزان">جيزان</option>
                <option value="ينبع">ينبع</option>
                <option value="الأحساء">الأحساء</option>
                <option value="القطيف">القطيف</option>
                <option value="عرعر">عرعر</option>
                <option value="سكاكا">سكاكا</option>
                <option value="حفر الباطن">حفر الباطن</option>
              </select>
            </div>

            <div class="flex flex-col gap-1.5">
              <label class="text-xs font-bold uppercase tracking-wider text-slate-700">عنوان التوصيل التفصيلي *</label>
              <textarea
                name="properties[Address]"
                id="input-address"
                required
                rows="3"
                placeholder="الحي، اسم الشارع، رقم المنزل..."
                class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 text-sm outline-none focus:border-blue-600 resize-none"
              ></textarea>
            </div>
          </div>

          <!-- Product Preferences -->
          <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-xs flex flex-col gap-5 text-right">
            <h3 class="text-lg font-extrabold text-slate-900 border-b border-slate-100 pb-3">
              2. تفاصيل المنتج
            </h3>

            <!-- Color Swatches -->
            <div>
              <label class="text-xs font-bold uppercase tracking-wider text-slate-700 block mb-2">
                اللون: <span id="selected-color-label" class="text-blue-600 font-bold">أبيض عاجي</span>
              </label>
              <input type="hidden" name="properties[Selected Color]" id="input-color-value" value="أبيض عاجي">
              <div class="flex items-center gap-3 flex-wrap" id="color-swatches-container">
                <button type="button" class="color-swatch-btn w-8 h-8 rounded-full border-2 border-white ring-2 ring-blue-600 ring-offset-2 scale-110 cursor-pointer" data-color="أبيض عاجي" style="background-color: #F5F1E6;"></button>
                <button type="button" class="color-swatch-btn w-8 h-8 rounded-full border-2 border-slate-300 hover:scale-105 cursor-pointer" data-color="أبيض ناصع" style="background-color: #F5F5F0;"></button>
                <button type="button" class="color-swatch-btn w-8 h-8 rounded-full border-2 border-slate-300 hover:scale-105 cursor-pointer" data-color="أسود فاخر" style="background-color: #3A3B3C;"></button>
                <button type="button" class="color-swatch-btn w-8 h-8 rounded-full border-2 border-slate-300 hover:scale-105 cursor-pointer" data-color="أزرق داكن" style="background-color: #2B3A55;"></button>
                <button type="button" class="color-swatch-btn w-8 h-8 rounded-full border-2 border-slate-300 hover:scale-105 cursor-pointer" data-color="وردي فاتح" style="background-color: #E8B5B5;"></button>
                <button type="button" class="color-swatch-btn w-8 h-8 rounded-full border-2 border-slate-300 hover:scale-105 cursor-pointer" data-color="كاكي أرضي" style="background-color: #A39171;"></button>
              </div>
            </div>

            <!-- Size Selector -->
            <div>
              <div class="flex items-center justify-between mb-2">
                <label class="text-xs font-bold uppercase tracking-wider text-slate-700">
                  المقاس: <span id="selected-size-label" class="text-blue-600 font-bold">لم يتم الاختيار</span>
                </label>
                <button type="button" id="open-size-guide-btn" class="text-xs font-bold text-blue-600 hover:underline cursor-pointer">
                  دليل المقاسات
                </button>
              </div>
              <input type="hidden" name="properties[Selected Size]" id="input-size-value" value="" required>
              <div class="grid grid-cols-4 gap-2" id="size-buttons-container">
                {% assign sizes = "EU 36,EU 37,EU 38,EU 39/40,EU 41,EU 42/43,EU 44,EU 45" | split: "," %}
                {% for sz in sizes %}
                  <button
                    type="button"
                    class="size-pill-btn py-2 px-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-800 text-xs font-bold hover:border-blue-400 cursor-pointer"
                    data-size="{{ sz }}"
                  >
                    {{ sz }}
                  </button>
                {% endfor %}
              </div>
              <span id="size-error-msg" class="hidden text-xs text-red-500 font-semibold mt-1.5 block">يرجى اختيار المقاس المناسب.</span>
            </div>

            <!-- Quantity -->
            <div>
              <label class="text-xs font-bold uppercase tracking-wider text-slate-700 block mb-2">الكمية</label>
              <div class="inline-flex items-center border-2 border-slate-200 rounded-xl overflow-hidden bg-slate-50">
                <button type="button" id="qty-minus" class="w-10 h-10 flex items-center justify-center font-bold text-slate-700 hover:bg-slate-200 text-lg cursor-pointer">−</button>
                <input type="number" name="quantity" id="checkout-qty-input" value="1" min="1" class="w-12 text-center font-extrabold text-sm text-slate-900 bg-transparent outline-none" readonly>
                <button type="button" id="qty-plus" class="w-10 h-10 flex items-center justify-center font-bold text-slate-700 hover:bg-slate-200 text-lg cursor-pointer">+</button>
              </div>
            </div>

          </div>

        </div>

        <!-- Order Summary Sidebar Right -->
        <div class="lg:col-span-5 sticky top-24">
          <div class="bg-gradient-to-b from-white via-slate-50 to-indigo-50/30 rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-lg flex flex-col gap-5 text-right">
            <h3 class="text-lg font-black text-slate-900 border-b border-slate-200 pb-3 flex items-center justify-between">
              <span>ملخص الطلب</span>
              <span class="bg-emerald-100 text-emerald-700 text-xs font-black px-2.5 py-0.5 rounded-full">
                توصيل سريع
              </span>
            </h3>

            <!-- Product info preview -->
            <div class="flex items-center gap-4">
              <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-slate-100 to-blue-50 p-1 shrink-0 overflow-hidden border border-blue-200 shadow-xs">
                <img
                  id="summary-product-img"
                  src="https://media.base44.com/images/public/user_69da7b6f0cdb618ca188b19b/b1ea75f66_O1CN01Q1qKXy1hiUaOYcOKo_2222575514311-0-cib.jpg"
                  alt="معاينة المنتج"
                  class="w-full h-full object-contain"
                >
              </div>
              <div>
                <h4 class="font-extrabold text-slate-900 text-sm sm:text-base">
                  {{ product.title | default: 'حذاء كروس كلاسيك ستار' }}
                </h4>
                <p class="text-xs text-blue-600 font-bold" id="summary-variant-text">
                  أبيض عاجي · اختر المقاس
                </p>
                <p class="text-xs text-slate-500 font-semibold" id="summary-qty-text">
                  الكمية: 1
                </p>
              </div>
            </div>

            <!-- Price Breakdown -->
            <div class="space-y-2 py-3 border-y border-slate-200 text-sm">
              <div class="flex justify-between text-slate-600">
                <span>المجموع الفرعي (<span id="summary-calc-text">1 × 189 ر.س</span>)</span>
                <span class="font-extrabold text-slate-900" id="summary-subtotal">189 ر.س</span>
              </div>
              <div class="flex justify-between text-slate-600">
                <span>الشحن السريع</span>
                <span class="font-black text-emerald-600">مجاناً</span>
              </div>
            </div>

            <!-- Grand Total -->
            <div class="flex items-center justify-between bg-blue-50/60 p-3.5 rounded-2xl border border-blue-100">
              <span class="text-base font-black text-slate-900">الإجمالي النهائي</span>
              <span class="text-2xl sm:text-3xl font-black text-blue-600">
                <span id="summary-grand-total">189</span> <span class="text-base font-extrabold text-slate-500">ر.س</span>
              </span>
            </div>

            <!-- Submit CTA Button -->
            <button
              type="submit"
              id="submit-order-btn"
              class="w-full bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 hover:from-blue-700 hover:via-indigo-700 hover:to-purple-700 text-white font-black py-4 rounded-2xl text-base tracking-wide shadow-xl shadow-blue-500/25 transition-all cursor-pointer flex items-center justify-center gap-2"
            >
              <span>تأكيد الطلب الآن</span>
            </button>

            <div class="space-y-2 text-xs text-slate-500 pt-2">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                <span>دفع آمن ومحمي 100% (الدفع عند الاستلام)</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1"/></svg>
                <span>توصيل سريع · 2-4 أيام عمل</span>
              </div>
            </div>

          </div>
        </div>

      </div>
    </form>
  </div>
</section>

<!-- Render Size Guide Modal Snippet -->
{% render 'size-guide-modal' %}

{% schema %}
{
  "name": "نموذج إتمام الطلب",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "شارة أعلى القسم",
      "default": "طلب سريع ومباشر"
    },
    {
      "type": "text",
      "id": "title",
      "label": "عنوان القسم الرئيسي",
      "default": "أكمل طلبك الآن"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "الوصف الفرعي",
      "default": "استلم طلبك خلال 2 إلى 4 أيام عمل — الدفع عند الاستلام"
    },
    {
      "type": "text",
      "id": "unit_price",
      "label": "سعر القطعة المفردة (ر.س)",
      "default": "189"
    }
  ],
  "presets": [
    {
      "name": "نموذج إتمام الطلب"
    }
  ]
}
{% endschema %}
