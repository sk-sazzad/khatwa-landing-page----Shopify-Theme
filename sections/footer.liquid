{% comment %}
  Footer Section
{% endcomment %}

<footer class="bg-slate-900 text-slate-300 pt-12 pb-12 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6 pb-8 border-b border-slate-800">
      <div class="space-y-2 text-center sm:text-right">
        <a href="#top" onclick="window.scrollTo({top:0,behavior:'smooth'});return false;" class="text-2xl sm:text-3xl font-black text-white tracking-tight inline-block">
          {{ section.settings.brand_name }}
        </a>
        <p class="text-xs sm:text-sm text-slate-400 leading-relaxed max-w-md">
          {{ section.settings.brand_description }}
        </p>
      </div>
    </div>
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p id="footer-year">© {{ 'now' | date: "%Y" }} {{ section.settings.copyright_text }}</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand Name", "default": "خطوة" },
    { "type": "textarea", "id": "brand_description", "label": "Brand Description", "default": "أحذية EVA الفاخرة مصممة للراحة اليومية. مقاومة للماء وخفيفة الوزن وتدوم طويلاً." },
    { "type": "text", "id": "copyright_text", "label": "Copyright Text", "default": "Cross Classic المملكة العربية السعودية. جميع الحقوق محفوظة." }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
