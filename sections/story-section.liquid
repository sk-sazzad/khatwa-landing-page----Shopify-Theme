<section id="story" class="py-16 lg:py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
      <span class="inline-block text-xs font-black uppercase tracking-widest bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 text-white px-4 py-1.5 rounded-full shadow-sm mb-3">
        {{ section.settings.badge | default: 'صُنع لراحتك' }}
      </span>
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        {{ section.settings.title | default: 'صُمم لكل لحظات يومك' }}
      </h2>
      <p class="mt-3 text-slate-600 text-base sm:text-lg">
        {{ section.settings.description | default: 'من روتينك الصباحي إلى مغامرات الشاطئ — اكتشف لماذا حذاء كروس كلاسيك ستار هو خيارك الأفضل دائماً.' }}
      </p>
    </div>

    <!-- Story Blocks Repeater -->
    <div class="flex flex-col gap-12 lg:gap-20">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% if block.settings.is_bleed %}
            <div
              class="relative rounded-3xl overflow-hidden shadow-xl min-h-[360px] sm:min-h-[420px] flex items-end group text-right"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.title }}" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
              {% else %}
                <img src="https://media.base44.com/images/public/6a646958821430317adbf321/749895e7f_generated_7b449968.png" alt="{{ block.settings.title }}" class="absolute inset-0 w-full h-full object-cover">
              {% endif %}
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-transparent"></div>
              <div class="relative p-6 sm:p-10 lg:p-12 text-white max-w-2xl">
                <span class="text-xs font-bold tracking-widest uppercase text-blue-400">
                  {{ block.settings.number }}
                </span>
                <h3 class="text-2xl sm:text-3xl lg:text-4xl font-black mt-1">
                  {{ block.settings.title }}
                </h3>
                <p class="mt-2 text-slate-200 text-sm sm:text-base leading-relaxed">
                  {{ block.settings.description }}
                </p>
                {% if block.settings.benefits != blank %}
                  <div class="flex flex-wrap gap-x-6 gap-y-2 mt-4 text-xs sm:text-sm font-semibold">
                    {% assign benefits_array = block.settings.benefits | split: "," %}
                    {% for benefit in benefits_array %}
                      <div class="flex items-center gap-1.5 text-emerald-300">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                        <span>{{ benefit | strip }}</span>
                      </div>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            </div>
          {% else %}
            {% assign is_even = forloop.index | modulo: 2 %}
            <div
              class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-white/90 via-blue-50/40 to-indigo-50/30 border border-blue-100 shadow-md text-right {% if is_even == 0 %}lg:grid-flow-dense{% endif %}"
              {{ block.shopify_attributes }}
            >
              <!-- Image -->
              <div class="aspect-4/3 rounded-3xl overflow-hidden bg-slate-100 shadow-md {% if is_even == 0 %}lg:col-start-2{% endif %}">
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title }}" class="w-full h-full object-cover transition-transform duration-500 hover:scale-105">
                {% else %}
                  <img src="https://media.base44.com/images/public/6a646958821430317adbf321/749895e7f_generated_7b449968.png" alt="{{ block.settings.title }}" class="w-full h-full object-cover">
                {% endif %}
              </div>

              <!-- Content -->
              <div class="flex flex-col gap-4">
                <div>
                  <span class="inline-block text-xs font-black tracking-widest uppercase bg-blue-100 text-blue-600 px-3 py-1 rounded-lg border border-blue-200">
                    {{ block.settings.number }}
                  </span>
                </div>
                <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
                  {{ block.settings.title }}
                </h3>
                <p class="text-slate-600 text-base leading-relaxed">
                  {{ block.settings.description }}
                </p>
                {% if block.settings.benefits != blank %}
                  <div class="flex flex-col gap-2.5 mt-2">
                    {% assign benefits_array = block.settings.benefits | split: "," %}
                    {% for benefit in benefits_array %}
                      <div class="flex items-center gap-2.5 font-bold text-slate-800 text-sm">
                        <div class="w-5 h-5 rounded-full bg-gradient-to-r from-emerald-500 to-teal-500 text-white flex items-center justify-center shrink-0 shadow-xs">
                          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                        </div>
                        <span>{{ benefit | strip }}</span>
                      </div>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "قصة ومميزات المنتج",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "شارة أعلى القسم",
      "default": "صُنع لراحتك"
    },
    {
      "type": "text",
      "id": "title",
      "label": "عنوان القسم",
      "default": "صُمم لكل لحظات يومك"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "وصف القسم",
      "default": "من روتينك الصباحي إلى مغامرات الشاطئ — اكتشف لماذا حذاء كروس كلاسيك ستار هو خيارك الأفضل دائماً."
    }
  ],
  "blocks": [
    {
      "type": "story_block",
      "name": "بطاقة ميزة تفصيلية",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "الرقم التسلسلي (مثال: 01)",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "عنوان الميزة",
          "default": "أقصى درجات الراحة"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "الوصف التفصيلي",
          "default": "مصمم خصيصاً للارتداء طوال اليوم، يمنحك حذاء كروس كلاسيك ستار إحساساً بالفخامة والنعومة بفضل فوم EVA المرن."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "صورة الميزة"
        },
        {
          "type": "text",
          "id": "benefits",
          "label": "الفوائد الفرعية (مفصولة بفاصلة)",
          "default": "وسادة قدم مريحة, فوم EVA ناعم, تصميم يقلل الضغط"
        },
        {
          "type": "checkbox",
          "id": "is_bleed",
          "label": "عرض كبطاقة خلفية كاملة (Full Bleed)",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "قصة ومميزات المنتج",
      "blocks": [
        {
          "type": "story_block",
          "settings": {
            "number": "01",
            "title": "أقصى درجات الراحة",
            "description": "مصمم خصيصاً للارتداء طوال اليوم، يمنحك حذاء كروس كلاسيك ستار إحساساً بالفخامة والنعومة بفضل فوم EVA المرن الذي يتكيف مع كل خطوة.",
            "benefits": "وسادة قدم مريحة, فوم EVA ناعم, تصميم يقلل الضغط"
          }
        },
        {
          "type": "story_block",
          "settings": {
            "number": "02",
            "title": "تصميم مقاوم للماء 100%",
            "description": "مصنوع من مادة EVA المقاومة للماء تماماً. الأمطار، رذاذ الماء، أو المسبح — تبقى قدمك جافة ويظل حذاؤك أنيقاً ونظيفاً.",
            "benefits": "مقاوم للماء 100%, سطح طارد للمياه, مثالي للمسبح والأمطار",
            "is_bleed": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
