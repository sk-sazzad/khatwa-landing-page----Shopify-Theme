{% comment %}
  Feature Badges Grid Section
{% endcomment %}

<section id="feat" class="py-12 border-y border-slate-200/80 dark:border-slate-800/80 bg-gradient-to-r from-slate-50 via-blue-50/20 to-indigo-50/20 dark:from-slate-900 dark:via-slate-900 dark:to-slate-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 sm:gap-6">
      {% for block in section.blocks %}
        <div class="feature-badge flex flex-col items-center justify-center text-center p-5 rounded-2xl {{ block.settings.card_bg_class }} border {{ block.settings.card_border_class }} shadow-xs cursor-default" {{ block.shopify_attributes }}>
          <div class="p-3.5 rounded-2xl {{ block.settings.icon_bg_class }} mb-3 shadow-xs">
            {% case block.settings.icon %}
              {% when 'water' %}
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-blue-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/></svg>
              {% when 'feather' %}
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-indigo-600 dark:text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"/><line x1="16" y1="8" x2="2" y2="22"/><line x1="17.5" y1="15" x2="9" y2="15"/></svg>
              {% when 'wind' %}
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-sky-600 dark:text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.7 7.7a2.5 2.5 0 1 1 1.8 4.3H2"/><path d="M9.6 4.6A2 2 0 1 1 11 8H2"/><path d="M12.6 19.4A2 2 0 1 0 14 16H2"/></svg>
              {% when 'sun' %}
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-600 dark:text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
              {% when 'shield' %}
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              {% else %}
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-purple-600 dark:text-purple-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
            {% endcase %}
          </div>
          <span class="text-xs sm:text-sm font-black text-slate-900 dark:text-slate-100">{{ block.settings.title }}</span>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Feature Badges",
  "settings": [],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Badge",
      "settings": [
        { "type": "text", "id": "title", "label": "Feature Title", "default": "مقاوم للماء" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "water", "label": "Waterdrop" },
            { "value": "feather", "label": "Feather / Lightweight" },
            { "value": "wind", "label": "Wind / Breathable" },
            { "value": "sun", "label": "Sun / Quick Dry" },
            { "value": "shield", "label": "Shield / Non-slip" },
            { "value": "sparkle", "label": "Sparkle / Easy Clean" }
          ],
          "default": "water"
        },
        { "type": "text", "id": "card_bg_class", "label": "Card Background Class", "default": "bg-gradient-to-b from-blue-500/10 via-cyan-500/10 to-blue-500/5 dark:from-blue-950/40 dark:to-cyan-950/20" },
        { "type": "text", "id": "card_border_class", "label": "Card Border Class", "default": "border-blue-200 dark:border-blue-800/60" },
        { "type": "text", "id": "icon_bg_class", "label": "Icon Background Class", "default": "bg-blue-100 dark:bg-blue-900/60" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Badges",
      "blocks": [
        { "type": "feature", "settings": { "title": "مقاوم للماء", "icon": "water", "card_bg_class": "bg-gradient-to-b from-blue-500/10 via-cyan-500/10 to-blue-500/5 dark:from-blue-950/40 dark:to-cyan-950/20", "card_border_class": "border-blue-200 dark:border-blue-800/60", "icon_bg_class": "bg-blue-100 dark:bg-blue-900/60" } },
        { "type": "feature", "settings": { "title": "خفيف الوزن", "icon": "feather", "card_bg_class": "bg-gradient-to-b from-indigo-500/10 via-purple-500/10 to-indigo-500/5 dark:from-indigo-950/40 dark:to-purple-950/20", "card_border_class": "border-indigo-200 dark:border-indigo-800/60", "icon_bg_class": "bg-indigo-100 dark:bg-indigo-900/60" } },
        { "type": "feature", "settings": { "title": "شبكي التهوية", "icon": "wind", "card_bg_class": "bg-gradient-to-b from-sky-500/10 via-teal-500/10 to-sky-500/5 dark:from-sky-950/40 dark:to-teal-950/20", "card_border_class": "border-sky-200 dark:border-sky-800/60", "icon_bg_class": "bg-sky-100 dark:bg-sky-900/60" } },
        { "type": "feature", "settings": { "title": "سريع الجفاف", "icon": "sun", "card_bg_class": "bg-gradient-to-b from-amber-500/10 via-orange-500/10 to-amber-500/5 dark:from-amber-950/40 dark:to-orange-950/20", "card_border_class": "border-amber-200 dark:border-amber-800/60", "icon_bg_class": "bg-amber-100 dark:bg-amber-900/60" } },
        { "type": "feature", "settings": { "title": "مانع للانزلاق", "icon": "shield", "card_bg_class": "bg-gradient-to-b from-emerald-500/10 via-green-500/10 to-emerald-500/5 dark:from-emerald-950/40 dark:to-green-950/20", "card_border_class": "border-emerald-200 dark:border-emerald-800/60", "icon_bg_class": "bg-emerald-100 dark:bg-emerald-900/60" } },
        { "type": "feature", "settings": { "title": "سهل التنظيف", "icon": "sparkle", "card_bg_class": "bg-gradient-to-b from-purple-500/10 via-pink-500/10 to-purple-500/5 dark:from-purple-950/40 dark:to-pink-950/20", "card_border_class": "border-purple-200 dark:border-purple-800/60", "icon_bg_class": "bg-purple-100 dark:bg-purple-900/60" } }
      ]
    }
  ]
}
{% endschema %}
