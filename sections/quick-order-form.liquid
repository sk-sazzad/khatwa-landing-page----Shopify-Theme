{% comment %}
  Quick Checkout / Cash-on-Delivery Order Form Section
{% endcomment %}

<section id="order" class="py-16 lg:py-24 bg-slate-100/80 dark:bg-slate-900/60 border-t border-slate-200 dark:border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-xl mx-auto mb-12">
      <span class="inline-block text-xs font-black uppercase tracking-widest bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 text-white px-4 py-1.5 rounded-full shadow-sm mb-3">
        {{ section.settings.badge_text }}
      </span>
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
        {{ section.settings.title_prefix }} <span class="bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 bg-clip-text text-transparent">{{ section.settings.title_highlight }}</span>
      </h2>
      <p class="mt-2 text-slate-600 dark:text-slate-400 text-sm sm:text-base font-medium">
        {{ section.settings.subtitle }}
      </p>
    </div>

    <!-- Success Confirmation State -->
    <div id="order-success" class="hidden max-w-lg mx-auto bg-white dark:bg-slate-800 rounded-3xl p-8 text-center border border-slate-200 dark:border-slate-700 shadow-xl flex flex-col items-center gap-4 animate-fade-zoom">
      <div class="w-16 h-16 rounded-full bg-emerald-100 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="9 12 11 14 16 9"/></svg>
      </div>
      <h3 class="text-2xl font-black text-slate-900 dark:text-white">تم تقديم طلبك بنجاح!</h3>
      <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed" id="success-msg"></p>
      <div class="w-full bg-slate-50 dark:bg-slate-900/60 p-4 rounded-2xl text-xs text-right space-y-1 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-800 my-2" id="success-details"></div>
      <button type="button" onclick="resetOrder()" class="mt-2 inline-flex items-center gap-2 bg-slate-900 dark:bg-white text-white dark:text-slate-900 px-6 py-3 rounded-xl font-bold text-sm cursor-pointer hover:opacity-90 transition-opacity">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.17"/></svg>
        تقديم طلب آخر
      </button>
    </div>

    <!-- Main Order Form -->
    <div id="order-form-wrapper">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Customer Delivery & Preferences -->
        <div class="lg:col-span-7 flex flex-col gap-6">
          
          <!-- Delivery Info Card -->
          <div class="bg-white dark:bg-slate-800 rounded-3xl p-6 sm:p-8 border border-slate-200/80 dark:border-slate-700/80 shadow-xs flex flex-col gap-5">
            <h3 class="text-lg font-extrabold text-slate-900 dark:text-white border-b border-slate-100 dark:border-slate-700 pb-3">1. معلومات التوصيل</h3>
            
            <div class="flex flex-col gap-1.5">
              <label class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">الاسم الكامل *</label>
              <input type="text" id="inp-name" placeholder="مثال: أحمد المنصور" class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white text-sm outline-none focus:border-blue-600 transition-colors text-right" />
              <span id="err-name" class="text-xs text-red-500 font-semibold hidden"></span>
            </div>

            <div class="flex flex-col gap-1.5">
              <label class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">رقم الهاتف *</label>
              <input type="tel" id="inp-phone" placeholder="مثال: 050 123 4567" class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white text-sm outline-none focus:border-blue-600 transition-colors" dir="ltr" />
              <span id="err-phone" class="text-xs text-red-500 font-semibold hidden"></span>
            </div>

            <div class="flex flex-col gap-1.5">
              <label class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">المدينة *</label>
              <select id="inp-city" class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white text-sm outline-none focus:border-blue-600 transition-colors cursor-pointer">
                <option value="">اختر مدينتك</option>
                {% assign cities = "الرياض,جدة,مكة المكرمة,المدينة المنورة,الدمام,الخبر,تبوك,أبها,الطائف,بريدة,خميس مشيط,حائل,نجران,جيزان,ينبع,الأحساء,القطيف,عرعر,سكاكا,حفر الباطن" | split: "," %}
                {% for c in cities %}
                  <option value="{{ c }}">{{ c }}</option>
                {% endfor %}
              </select>
              <span id="err-city" class="text-xs text-red-500 font-semibold hidden"></span>
            </div>

            <div class="flex flex-col gap-1.5">
              <label class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">عنوان التوصيل *</label>
              <textarea id="inp-address" rows="3" placeholder="الحي، اسم الشارع، رقم المبنى..." class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white text-sm outline-none focus:border-blue-600 transition-colors resize-none text-right"></textarea>
              <span id="err-address" class="text-xs text-red-500 font-semibold hidden"></span>
            </div>
          </div>

          <!-- Product Preferences Card -->
          <div class="bg-white dark:bg-slate-800 rounded-3xl p-6 sm:p-8 border border-slate-200/80 dark:border-slate-700/80 shadow-xs flex flex-col gap-5">
            <h3 class="text-lg font-extrabold text-slate-900 dark:text-white border-b border-slate-100 dark:border-slate-700 pb-3">2. تفضيلات المنتج</h3>
            
            <div>
              <label class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 block mb-2">
                اللون: <span id="order-color-label" class="text-blue-600 dark:text-blue-400">أبيض عاجي</span>
              </label>
              <div id="order-colors" class="flex items-center gap-3 flex-wrap">
                {% assign colors = "أبيض عاجي:#F5F1E6:0,أبيض:#F5F5F0:1,أسود:#3A3B3C:2,أزرق داكن:#2B3A55:5,وردي:#E8B5B5:4,كاكي:#A39171:3" | split: "," %}
                {% for item in colors %}
                  {% assign parts = item | split: ":" %}
                  <button type="button" 
                          onclick="selectColor('{{ parts[0] }}', {{ parts[2] }})" 
                          data-color-name="{{ parts[0] }}"
                          style="background-color: {{ parts[1] }}" 
                          class="color-swatch-btn w-8 h-8 rounded-full border-2 transition-all cursor-pointer relative shadow-sm {% if forloop.first %}ring-4 ring-blue-500/40 border-white dark:border-slate-800 scale-110 shadow-md{% else %}border-slate-300 dark:border-slate-700 hover:scale-105{% endif %}">
                  </button>
                {% endfor %}
              </div>
            </div>

            <div>
              <div class="flex items-center justify-between mb-2">
                <label class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                  المقاس: <span id="order-size-label" class="text-blue-600 dark:text-blue-400">غير محدد</span>
                </label>
                <button type="button" onclick="openSizeGuide()" class="text-xs font-bold text-blue-600 dark:text-blue-400 hover:underline cursor-pointer">دليل المقاسات</button>
              </div>
              <div id="order-sizes" class="grid grid-cols-4 gap-2">
                {% assign sizes = "EU 36,EU 37,EU 38,EU 39/40,EU 41,EU 42/43,EU 44,EU 45" | split: "," %}
                {% for sz in sizes %}
                  <button type="button" onclick="selectSize('{{ sz }}')" data-size-value="{{ sz }}" class="size-select-btn py-2.5 px-3 rounded-xl border text-sm font-black transition-all cursor-pointer border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 hover:border-blue-400">
                    {{ sz }}
                  </button>
                {% endfor %}
              </div>
              <span id="err-size" class="text-xs text-red-500 font-semibold mt-1.5 hidden block"></span>
            </div>

            <div>
              <label class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 block mb-2">الكمية</label>
              <div class="inline-flex items-center border-2 border-slate-200 dark:border-slate-700 rounded-xl overflow-hidden bg-slate-50 dark:bg-slate-900">
                <button type="button" onclick="changeQty(-1)" class="w-10 h-10 flex items-center justify-center font-bold text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-800 text-lg cursor-pointer">−</button>
                <span id="qty-display" class="w-12 text-center font-extrabold text-sm text-slate-900 dark:text-white">1</span>
                <button type="button" onclick="changeQty(1)" class="w-10 h-10 flex items-center justify-center font-bold text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-800 text-lg cursor-pointer">+</button>
              </div>
            </div>

          </div>
        </div>

        <!-- Order Summary Sidebar -->
        <div class="lg:col-span-5 sticky top-24">
          <div class="bg-gradient-to-b from-white via-slate-50 to-indigo-50/30 dark:from-slate-800 dark:via-slate-800 dark:to-indigo-950/20 rounded-3xl p-6 sm:p-8 border border-slate-200/80 dark:border-slate-700/80 shadow-lg flex flex-col gap-5">
            <h3 class="text-lg font-black text-slate-900 dark:text-white border-b border-slate-200/80 dark:border-slate-700 pb-3 flex items-center justify-between">
              <span>ملخص الطلب</span>
              <span class="bg-emerald-100 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-400 text-xs font-black px-2.5 py-0.5 rounded-full">توصيل سريع</span>
            </h3>

            <div class="flex items-center gap-4">
              <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-slate-100 to-blue-50 dark:from-slate-900 dark:to-slate-800 p-1 shrink-0 overflow-hidden border border-blue-200/60 dark:border-slate-700 shadow-xs">
                {% assign order_img = "https://media.base44.com/images/public/user_69da7b6f0cdb618ca188b19b/b1ea75f66_O1CN01Q1qKXy1hiUaOYcOKo_2222575514311-0-cib.jpg" %}
                {% if section.settings.product_image != blank %}
                  {% assign order_img = section.settings.product_image | image_url: width: 300 %}
                {% endif %}
                <img id="order-preview-img" src="{{ order_img }}" alt="معاينة المنتج" class="w-full h-full object-contain" />
              </div>
              <div>
                <h4 class="font-extrabold text-slate-900 dark:text-white text-sm sm:text-base">{{ section.settings.product_title }}</h4>
                <p class="text-xs text-blue-600 dark:text-blue-400 font-bold" id="order-product-desc">أبيض عاجي · اختر المقاس</p>
                <p class="text-xs text-slate-500 dark:text-slate-400 font-semibold" id="order-qty-label">الكمية: 1</p>
              </div>
            </div>

            <div class="space-y-2 py-3 border-y border-slate-200/80 dark:border-slate-700/80 text-sm">
              <div class="flex justify-between text-slate-600 dark:text-slate-400">
                <span id="subtotal-label">المجموع الفرعي (1 × {{ section.settings.unit_price }} ر.س)</span>
                <span class="font-extrabold text-slate-900 dark:text-white" id="subtotal-val">{{ section.settings.unit_price }} ر.س</span>
              </div>
              <div class="flex justify-between text-slate-600 dark:text-slate-400">
                <span>الشحن السريع</span>
                <span class="font-black text-emerald-600 dark:text-emerald-400">مجاناً</span>
              </div>
            </div>

            <div class="flex items-center justify-between bg-blue-50/60 dark:bg-blue-950/40 p-3.5 rounded-2xl border border-blue-100 dark:border-blue-900/50">
              <span class="text-base font-black text-slate-900 dark:text-white">الإجمالي الكلي</span>
              <span class="text-2xl sm:text-3xl font-black text-blue-600 dark:text-blue-400" id="grand-total" data-price="{{ section.settings.unit_price }}" id="order-base-price">
                {{ section.settings.unit_price }} <span class="text-base font-extrabold text-slate-500">ر.س</span>
              </span>
            </div>

            <button type="button" id="submit-btn" onclick="submitOrder()" class="w-full bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 hover:from-blue-700 hover:via-indigo-700 hover:to-purple-700 text-white font-black py-4 rounded-2xl text-base tracking-wide shadow-xl shadow-blue-500/25 hover:shadow-2xl transition-all cursor-pointer flex items-center justify-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <span id="submit-btn-text">تأكيد الطلب</span>
            </button>

            <div class="space-y-2 text-xs text-slate-500 dark:text-slate-400 pt-2">
              <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
                <span>دفع مشفّر وآمن 100%</span>
              </div>
              <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 17H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v3"/><polygon points="12 12 22 12 22 17 12 17 12 12"/><circle cx="17" cy="21" r="2"/><circle cx="7" cy="21" r="2"/></svg>
                <span>توصيل سريع · 2-4 أيام عمل</span>
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Quick Checkout COD Form",
  "settings": [
    { "type": "text", "id": "badge_text", "label": "Badge Text", "default": "الدفع السريع" },
    { "type": "text", "id": "title_prefix", "label": "Title Prefix", "default": "أكمل" },
    { "type": "text", "id": "title_highlight", "label": "Title Highlight", "default": "طلبك" },
    { "type": "text", "id": "subtitle", "label": "Subtitle Description", "default": "دفع سريع — استلم حذاءك خلال 2-4 أيام عمل" },
    { "type": "text", "id": "product_title", "label": "Summary Product Title", "default": "كروس كلاسيك ستار كلوجز" },
    { "type": "image_picker", "id": "product_image", "label": "Upload Summary Product Image" },
    { "type": "text", "id": "unit_price", "label": "Unit Price SAR", "default": "189" }
  ],
  "presets": [
    {
      "name": "Quick Checkout COD Form"
    }
  ]
}
{% endschema %}
