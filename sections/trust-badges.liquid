<section class="trust-bar">
  <div class="container">
    <div class="trust-grid">
      
      <div class="trust-item">
        <div class="trust-item-icon">
          {% render 'icon-truck' %}
        </div>
        <div>
          <h4 class="font-bold text-base">{{ 'trust.free_shipping' | t }}</h4>
          <p class="text-xs text-slate-400 mt-0.5">{{ 'trust.free_shipping_sub' | t }}</p>
        </div>
      </div>

      <div class="trust-item">
        <div class="trust-item-icon">
          {% render 'icon-shield' %}
        </div>
        <div>
          <h4 class="font-bold text-base">{{ 'trust.guarantee' | t }}</h4>
          <p class="text-xs text-slate-400 mt-0.5">{{ 'trust.guarantee_sub' | t }}</p>
        </div>
      </div>

      <div class="trust-item">
        <div class="trust-item-icon">
          {% render 'icon-check' %}
        </div>
        <div>
          <h4 class="font-bold text-base">{{ 'trust.secure_checkout' | t }}</h4>
          <p class="text-xs text-slate-400 mt-0.5">{{ 'trust.secure_checkout_sub' | t }}</p>
        </div>
      </div>

      <div class="trust-item">
        <div class="trust-item-icon">
          {% render 'icon-clock' %}
        </div>
        <div>
          <h4 class="font-bold text-base">{{ 'trust.support' | t }}</h4>
          <p class="text-xs text-slate-400 mt-0.5">{{ 'trust.support_sub' | t }}</p>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust Badges Bar",
  "settings": [],
  "presets": [
    {
      "name": "Trust Badges Bar"
    }
  ]
}
{% endschema %}
