<section id="reviews" class="py-16 lg:py-24 bg-slate-100/70">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-xl mx-auto mb-10">
      <span class="inline-block text-xs font-black uppercase tracking-widest bg-gradient-to-r from-amber-500 to-orange-500 text-white px-4 py-1.5 rounded-full shadow-sm mb-3">
        {{ section.settings.badge | default: 'آراء وتقييمات العملاء' }}
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        {{ section.settings.title | default: 'نال إعجاب الآلاف' }}
      </h2>
    </div>

    <!-- Rating Summary Card -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 bg-gradient-to-br from-amber-50/80 via-orange-50/40 to-amber-50/60 rounded-3xl p-6 sm:p-8 border border-amber-200 shadow-md mb-10 items-center text-right">
      <div class="flex flex-col items-center justify-center text-center p-4 lg:border-l border-amber-200">
        <span class="text-5xl font-black bg-gradient-to-r from-amber-600 to-orange-600 bg-clip-text text-transparent">
          {{ section.settings.overall_rating | default: '4.8' }}
        </span>
        <div class="flex text-amber-400 my-2">
          {% for i in (1..5) %}
            <svg class="w-5 h-5 fill-amber-400 text-amber-400" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          {% endfor %}
        </div>
        <span class="text-sm text-slate-600 font-bold">
          {{ section.settings.reviews_count_text | default: 'بناءً على 4,892 تقييم موثق' }}
        </span>
      </div>

      <div class="lg:col-span-2 flex flex-col justify-center space-y-3">
        <div class="flex items-center gap-3 text-xs sm:text-sm text-slate-600">
          <span class="w-16 font-bold">5 نجوم</span>
          <div class="flex-1 bg-slate-200 h-3.5 rounded-full overflow-hidden p-0.5 shadow-inner relative">
            <div class="bg-gradient-to-r from-amber-400 via-amber-500 to-orange-400 h-full rounded-full w-[87%]"></div>
          </div>
          <span class="w-12 text-left font-black text-amber-600">87%</span>
        </div>
        <div class="flex items-center gap-3 text-xs sm:text-sm text-slate-600">
          <span class="w-16 font-bold">4 نجوم</span>
          <div class="flex-1 bg-slate-200 h-3.5 rounded-full overflow-hidden p-0.5 shadow-inner relative">
            <div class="bg-gradient-to-r from-amber-400 via-amber-500 to-orange-400 h-full rounded-full w-[12%]"></div>
          </div>
          <span class="w-12 text-left font-black text-amber-600">12%</span>
        </div>
        <div class="flex items-center gap-3 text-xs sm:text-sm text-slate-600">
          <span class="w-16 font-bold">3 نجوم</span>
          <div class="flex-1 bg-slate-200 h-3.5 rounded-full overflow-hidden p-0.5 shadow-inner relative">
            <div class="bg-gradient-to-r from-amber-400 via-amber-500 to-orange-400 h-full rounded-full w-[1%]"></div>
          </div>
          <span class="w-12 text-left font-black text-amber-600">1%</span>
        </div>
      </div>
    </div>

    <!-- Reviews Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="bg-gradient-to-br from-white/90 via-amber-50/20 to-orange-50/30 rounded-2xl p-6 border border-amber-200 shadow-sm hover:shadow-md transition-all flex flex-col justify-between gap-4 text-right" {{ block.shopify_attributes }}>
            <div class="flex flex-col gap-3">
              <div class="flex items-center justify-between">
                <div class="flex text-amber-400">
                  {% assign rating_num = block.settings.rating | plus: 0 %}
                  {% for i in (1..5) %}
                    <svg class="w-4 h-4 {% if i <= rating_num %}fill-amber-400 text-amber-400{% else %}text-slate-200{% endif %}" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  {% endfor %}
                </div>
                {% if block.settings.verified %}
                  <span class="flex items-center gap-1 text-xs font-bold text-emerald-600">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    مشتري موثق
                  </span>
                {% endif %}
              </div>

              <h4 class="font-extrabold text-slate-900 text-base">
                {{ block.settings.title }}
              </h4>
              <p class="text-sm text-slate-600 leading-relaxed">
                "{{ block.settings.body }}"
              </p>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-full bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 text-white font-black flex items-center justify-center text-sm shadow-xs">
                  {{ block.settings.name | slice: 0 }}
                </div>
                <div>
                  <div class="text-sm font-bold text-slate-900 leading-tight">
                    {{ block.settings.name }}
                  </div>
                  <div class="text-xs text-slate-500">
                    {{ block.settings.city }} · {{ block.settings.date }}
                  </div>
                </div>
              </div>
              <div class="text-left text-xs text-slate-400 font-medium">
                {{ block.settings.variant_info }}
              </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "آراء وتقييمات العملاء",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "شارة أعلى القسم",
      "default": "آراء وتقييمات العملاء"
    },
    {
      "type": "text",
      "id": "title",
      "label": "عنوان القسم",
      "default": "نال إعجاب الآلاف"
    },
    {
      "type": "text",
      "id": "overall_rating",
      "label": "متوسط التقييم الإجمالي",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "reviews_count_text",
      "label": "نص عدد التقييمات",
      "default": "بناءً على 4,892 تقييم موثق"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "تقييم عميل",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "اسم العميل",
          "default": "أحمد القحطاني"
        },
        {
          "type": "text",
          "id": "city",
          "label": "المدينة",
          "default": "الرياض"
        },
        {
          "type": "select",
          "id": "rating",
          "label": "التقييم (1 - 5)",
          "options": [
            { "value": "5", "label": "5 نجوم" },
            { "value": "4", "label": "4 نجوم" },
            { "value": "3", "label": "3 نجوم" }
          ],
          "default": "5"
        },
        {
          "type": "text",
          "id": "date",
          "label": "التاريخ/الفترة",
          "default": "منذ أسبوعين"
        },
        {
          "type": "text",
          "id": "title",
          "label": "عنوان التقييم",
          "default": "أفضل حذاء امتلكته على الإطلاق"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "نص التقييم",
          "default": "صراحةً أنعم وأريح حذاء اشتريته منذ سنوات. أرتديه في المنزل وللمسجد وللمشاوير."
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "مشتري موثق",
          "default": true
        },
        {
          "type": "text",
          "id": "variant_info",
          "label": "معلومات اللون والمقاس",
          "default": "أبيض عاجي · EU 42/43"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "آراء وتقييمات العملاء",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "name": "أحمد القحطاني",
            "city": "الرياض",
            "rating": "5",
            "title": "أفضل حذاء امتلكته على الإطلاق",
            "body": "صراحةً أنعم وأريح حذاء اشتريته منذ سنوات. أرتديه في المنزل وللمسجد وللمشاوير. اللون العاجي فخم جداً وخفيف للغاية.",
            "variant_info": "أبيض عاجي · EU 42/43"
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "فاطمة العتيبي",
            "city": "جدة",
            "rating": "5",
            "title": "ممتاز للاستخدام اليومي",
            "body": "اشتريته للحديقة وأصبحت أرتديه في كل مكان. سهولة تنظيفه خيالية — مجرد شطف بالماء ويرجع كأنه جديد.",
            "variant_info": "كاكي أرضي · EU 38"
          }
        }
      ]
    }
  ]
}
{% endschema %}
