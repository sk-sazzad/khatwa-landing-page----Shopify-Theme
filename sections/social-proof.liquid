{% comment %}
  Social Proof Counter Section
{% endcomment %}

<section id="social-proof" class="bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 text-white py-16 relative overflow-hidden border-y border-indigo-900/50">
  <div class="absolute top-0 right-1/3 w-80 h-80 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 left-1/4 w-80 h-80 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <p class="text-center text-xs font-black uppercase tracking-widest text-indigo-400 mb-10 bg-indigo-900/40 border border-indigo-700/50 w-max mx-auto px-4 py-1 rounded-full">
      {{ section.settings.badge_text }}
    </p>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 text-center">
      {% for block in section.blocks %}
        <div class="p-4 rounded-2xl bg-white/5 backdrop-blur-xs border border-white/10 hover:border-white/20 transition-all" {{ block.shopify_attributes }}>
          <div class="stat-counter text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight bg-gradient-to-r from-blue-400 via-indigo-300 to-purple-400 bg-clip-text text-transparent font-mono"
               data-target="{{ block.settings.target_number }}"
               data-suffix="{{ block.settings.number_suffix }}">
            0
          </div>
          <div class="text-xs sm:text-sm font-bold text-indigo-200 mt-2">{{ block.settings.label }}</div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Social Proof Counters",
  "settings": [
    { "type": "text", "id": "badge_text", "label": "Badge Text", "default": "موثوق به عالميًا" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat Item",
      "settings": [
        { "type": "number", "id": "target_number", "label": "Target Number", "default": 48920 },
        { "type": "text", "id": "number_suffix", "label": "Suffix (+, %, etc.)", "default": "+" },
        { "type": "text", "id": "label", "label": "Label", "default": "عميل سعيد" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social Proof Counters",
      "blocks": [
        { "type": "stat", "settings": { "target_number": 48920, "number_suffix": "+", "label": "عميل سعيد" } },
        { "type": "stat", "settings": { "target_number": 127500, "number_suffix": "+", "label": "طلب تم توصيله" } },
        { "type": "stat", "settings": { "target_number": 4892, "number_suffix": "", "label": "تقييم إيجابي" } },
        { "type": "stat", "settings": { "target_number": 15, "number_suffix": "", "label": "دولة نخدمها" } }
      ]
    }
  ]
}
{% endschema %}
